; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Forrest"
config/version="0.2-dev"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://autoload/input_setup.gd"
GameState="*res://autoload/game_state.gd"
Clock="*res://autoload/clock.gd"
Energy="*res://autoload/energy.gd"
ForestSession="*res://autoload/forest_session.gd"
Missions="*res://autoload/missions.gd"
SaveSystem="*res://autoload/save_system.gd"
Fx="*res://autoload/fx.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://scenes/ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
